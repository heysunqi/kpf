apiVersion: v1
kind: Config
clusters:
- name: prod-cluster
  cluster:
    server: https://prod.example.com:6443
    certificate-authority-data: VGVzdA==
contexts:
- name: prod
  context:
    cluster: prod-cluster
    user: prod-user
    namespace: default
current-context: prod
users:
- name: prod-user
  user:
    token: fake-token-1
- name: staging-user
  user:
    token: fake-token-2
